{
  "name": "ufo-tech/rpc-objects",
  "description": "Component for UFO-Tech RPC Library",
  "license": "MIT",
  "authors": [
    {
      "name": "Alex Maistrenko",
      "email": "ashterix69@gmail.com"
    },
    {
      "name" : "Valik Nikolaev",
      "email" : "valiknik225@gmail.com"
    }
  ],
  "type": "component",
  "homepage": "https://docs.ufo-tech.space/bin/view/docs/JsonRpcBundle/?language=en",
  "require": {
    "php": ">=8.3",
    "ufo-tech/rpc-exceptions": "*",
    "ufo-tech/dto-transformer": "^3",
    "symfony/serializer": "^7.2",
    "symfony/validator": "^7.2",
    "symfony/http-client": "*",
    "symfony/property-access": "*",
    "ext-intl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/cache": "^7.2",
    "symfony/lock": "^7.2"
  },
  "autoload-dev": {
    "psr-4": {
      "Ufo\\RpcObject\\Tests\\": "tests/"
    }
  },
  "autoload": {
    "psr-4": {
      "Ufo\\RpcObject\\": "src/"
    }
  },
  "extra": {
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": [
      "@putenv XDEBUG_MODE=coverage",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text --coverage-html build/coverage"
    ],
    "auto-scripts": {
    }
  }
}
